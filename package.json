{
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "chokidar": "^5.0.0",
    "detect-port": "^2.1.0",
    "eslint": "^10.8.1",
    "fuzzysort": "^4.0.2",
    "live-server": "^1.2.2",
    
    "node-gyp": "^13.0.1",
    "@lydell/node-pty": "^1.1.0",
    "simple-git": "^3.36.0",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "which": "^7.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "name": "newfoldernf",
  "version": "1.0.0",
  "description": "Noferic IDE is a integrated development environment for the built with web technologies.",
  "main": "main_p/main.js",
  "type":"module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.charan.noferic",
    "productName": "Noferic IDE",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "logo2.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achu62/noferic-IDE.git"
  },
  "author": "",
