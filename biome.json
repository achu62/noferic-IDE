{
	 "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	    "vcs" : {
		"enabled": false,
		"clientKind": "git",
		
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noExcessiveCognitiveComplexity": "error",
				"noForEach": "warn",
				"useFlatMap": "warn"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"noAssignInExpressions": "error"
			},
			"style": {
				"noParameterAssign": "error"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html":{
		"experimentalFullSupportEnabled":true
	}
}
