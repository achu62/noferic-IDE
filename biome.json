{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": []
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noExcessiveCognitiveComplexity": "error",
				"noForEach": "warn",
				"useFlatMap": "warn"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"noAssignInExpressions": "error"
			},
			"style": {
				"noArguments": "error",
				"noParameterAssign": "error"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
